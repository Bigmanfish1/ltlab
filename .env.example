# ─── Local development (docker-compose) ───
# Database
POSTGRES_DB=ltlab
POSTGRES_USER=ltlab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ltlab:change-me@db:5432/ltlab

# Django
SECRET_KEY=generate-a-real-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase (auth) — Supabase → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# ─── Production (Cloud Run) ───
# Provisioned by infra/bootstrap.sh; never committed. Two mechanisms:
#
# Plain env on the service + ltlab-migrate Job:
#   DJANGO_SETTINGS_MODULE=config.settings.production
#   DEBUG=False
#   ALLOWED_HOSTS=.run.app                       # leading dot matches the Cloud Run host
#   SUPABASE_URL / SUPABASE_ANON_KEY             # same project as local
#
# Secret Manager (mounted via --set-secrets, version-pinned; NOT plain env):
#   ltlab-secret-key           = <python -c "import secrets; print(secrets.token_urlsafe(50))">
#   ltlab-database-url         = <Supabase transaction pooler URI, port 6543 (IPv4)>  # app; needs DISABLE_SERVER_SIDE_CURSORS
#   ltlab-migrate-database-url = <Supabase session pooler URI, port 5432 (IPv4)>      # migrate Job (DDL); optional, defaults to ltlab-database-url
# bootstrap.sh reads SECRET_KEY/DATABASE_URL (and optional MIGRATE_DATABASE_URL) from your env to seed these on a fresh project.
# Rotate: gcloud secrets versions add <secret> --data-file=- ; then redeploy.
